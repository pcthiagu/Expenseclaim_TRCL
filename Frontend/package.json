{
  "name": "travel-claim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:domain": "tsx --test tests/*.test.ts",
    "sandbox:bundle": "node scripts/sandbox/bundle.mjs",
    "sandbox:e2e": "OUT_DIR=dist-ui VITE_API_BASE_URL=http://127.0.0.1:4300 VITE_OCR_MODE=remote VITE_OCR_ENDPOINT=http://127.0.0.1:4199/ocr node scripts/sandbox/bundle.mjs && tsx scripts/sandbox/e2e.mjs",
    "sandbox:e2e:api": "OUT_DIR=dist-api VITE_API_BASE_URL=http://127.0.0.1:4300 VITE_OCR_MODE=off node scripts/sandbox/bundle.mjs && tsx scripts/sandbox/e2e-api.mjs",
    "sql:lint": "node scripts/lintSql.mjs"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
